# Set variables through your shell or service manager.
CC_PRODUCTION=0
# Public synthetic demo only: allows initial seed with debug disabled.
CC_PUBLIC_DEMO=0
# Serve compiled frontend/dist from Django (the container sets this to 1).
CC_SERVE_FRONTEND=0
CC_HOSTS=localhost,127.0.0.1
CC_TRUSTED_ORIGINS=http://localhost:15270,http://127.0.0.1:15270
CC_BACKEND_URL=http://127.0.0.1:18270
CC_SESSION_COOKIE=careconnect_v3_session
# Simulated password-reset mailbox. Always disabled in production.
CC_DEMO_MAILBOX=1
# CC_SQLITE=/path/to/db.sqlite3
# Required with CC_PRODUCTION=1
# CC_SECRET_KEY=
# CC_DB_HOST=localhost
# CC_DB_PORT=5432
# CC_DB_NAME=careconnect
# CC_DB_USER=careconnect
# CC_DB_PASSWORD=
# Render adds RENDER_EXTERNAL_HOSTNAME automatically; the app trusts its HTTPS origin.
# For a custom domain set CC_HOSTS and CC_TRUSTED_ORIGINS explicitly.
